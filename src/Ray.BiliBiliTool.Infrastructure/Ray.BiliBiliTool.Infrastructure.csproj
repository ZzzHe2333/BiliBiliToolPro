<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Ray.Infrastructure" />
    <!--
      Ray.Infrastructure 0.0.26 传递依赖 Rougamo.Fody >= 5.0.1。
      本项目只消费已经编译好的 Ray.Infrastructure，不需要再次运行 Rougamo/Fody 编织；
      同时 Rougamo 5.x Analyzer 所需 Roslyn 高于 .NET 8 SDK。
      因此保留包的 compile/runtime 依赖，只排除 analyzers 与 build/buildTransitive 资产。
    -->
    <PackageReference Include="Rougamo.Fody" ExcludeAssets="analyzers;build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>
</Project>
